{
  "name": "govai-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "demo:connected-ui": "node scripts/demo-connected-ui.cjs",
    "start": "node scripts/expo.cjs start --go --lan",
    "android": "node scripts/expo.cjs start --go --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint App.tsx index.ts layout.ts pages components scripts/*.cjs eslint.config.cjs",
    "format": "prettier --write \"*.{ts,tsx,json,cjs}\" \"pages/**/*.tsx\" \"components/**/*.tsx\" \"scripts/*.cjs\"",
    "format:check": "prettier --check \"*.{ts,tsx,json,cjs}\" \"pages/**/*.tsx\" \"components/**/*.tsx\" \"scripts/*.cjs\"",
    "check:expo": "node scripts/expo.cjs install --check",
    "export:android": "node scripts/expo.cjs export --platform android --output-dir dist/android",
    "preview:account-created:dev": "node scripts/preview-account-created.cjs",
    "preview:check-email:dev": "node scripts/preview-check-email.cjs",
    "preview:reset-password:dev": "node scripts/preview-reset-password.cjs",
    "preview:password-updated:dev": "node scripts/preview-password-updated.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "expo": "~57.0.31",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "~19.2.2",
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
