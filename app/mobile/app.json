{
  "expo": {
    "name": "GovAI",
    "slug": "govai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "lk.govai.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "eas": {
        "projectId": "9f6f8b0c-bc06-4118-a908-8efa920d291b"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GovAI to select a profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "govai"
  }
}
