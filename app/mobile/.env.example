# Public backend origins only. Use an address reachable and TLS-trusted by the phone.
# localhost points to the phone, not the development laptop.
EXPO_PUBLIC_AUTH_API_URL=
EXPO_PUBLIC_CORE_API_URL=

# Optional exact HTTPS reset-page URL, once app/universal linking is configured.
# Public address only; never include a reset token here.
EXPO_PUBLIC_PASSWORD_RESET_URL=
