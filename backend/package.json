{
  "name": "govai-backend",
  "version": "0.1.0",
  "description": "Node + Express API for the GovAI agentic platform",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
