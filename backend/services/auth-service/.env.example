# Copy to .env in this service directory for local development. Process settings win.
PORT=5000

# Exact browser origins, comma-separated; empty disables cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional for server startup; required by go run ./cmd/oidc-check.
# Realm identifiers are case-sensitive. This local realm is named GovAI.
OIDC_ISSUER_URL=http://localhost:8180/realms/GovAI
# Total discovery + JWKS deadline; positive Go duration, maximum 30s.
OIDC_CHECK_TIMEOUT=5s

# Optional database configuration; backend/dev/auth-postgres/setup.ps1 generates
# a private .env.database for isolated local development. Never use the owner
# connection as DATABASE_URL. Remote databases require sslmode=verify-full.
DATABASE_URL=
# Put MIGRATION_DATABASE_URL in a separate private .env.database-admin used
# only by cmd/db migrate; do not supply owner credentials to the API process.
# Independent, stable base64-encoded 32-byte secrets. Back up outside Git.
PROFILE_DATA_KEY=
NIC_INDEX_KEY=

# Registration is opt-in. Generate a separate private configuration with:
# .\scripts\new-registration-env.ps1
# See docs/GA-48-registration-runtime.md. That private file takes precedence
# over this file; process environment settings still win.
REGISTRATION_ENABLED=false

# Native mobile/Postman access-token login only; browser sessions are deferred.
# Local setup: go run ./cmd/dev-auth configure-login (writes ignored .env.login).
# See docs/GA-48-login.md. Keep the login client separate from registration admin.
LOGIN_ENABLED=false
# Opt-in native token issuance and /api/v1/auth/refresh + /revoke.
# Requires a reviewed refresh-enabled Keycloak client; see GA-50 documentation.
LOGIN_REFRESH_ENABLED=false

# Shared JWT/RBAC protected endpoints. Local setup writes ignored .env.authorization:
# go run ./cmd/dev-auth configure-authorization
API_AUTH_ENABLED=false

# Opt-in encrypted browser sessions. Separate web client and independent keys
# are required; see docs/GA-50-token-management.md. Migration is explicit.
WEB_SESSION_ENABLED=false
WEB_ORIGIN=
WEB_ISSUER_URL=
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
WEB_AUDIENCE=
WEB_CA_FILE=
WEB_SESSION_DATA_KEY=
WEB_RATE_KEY=
WEB_SESSION_LIFETIME=30m
