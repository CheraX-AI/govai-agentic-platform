# auth-service settings. Copy to .env in this service directory for local development.
# .env is the service's only runtime settings file (private, git-ignored).
# Process environment settings win over .env. In deployment, supply these as
# environment variables from a secrets store; do not ship .env files.
#
# The database owner login for migrations is NOT in .env. It lives in a separate
# private .env.migrate (MIGRATION_DATABASE_URL only), loaded only by the
# privileged `go run ./tools/db ...` commands, never by the API process.
#
# Local setup tools write into .env in place (keys are updated on their own line):
#   infrastructure/postgres/auth/setup.ps1  -> Database section + .env.migrate
#   .\scripts\new-registration-env.ps1       -> Registration section
#   go run ./tools/dev-auth configure*      -> Registration / Login / Web session / API authorization

# -- Server ------------------------------------------------------------
PORT=5001
# HTTPS certificate for this API (written by dev-auth configure).
API_TLS_CERT_FILE=
API_TLS_KEY_FILE=
# Exact browser origins, comma-separated; empty disables cross-origin access.
# The web app (Vite or the web container) runs on https://localhost:5173.
CORS_ALLOWED_ORIGINS=https://localhost:5173
# Optional for server startup; required by go run ./tools/oidc-check.
# Realm identifiers are case-sensitive. This local realm is named GovAI.
OIDC_ISSUER_URL=https://localhost:8443/realms/GovAI
# Total discovery + JWKS deadline; positive Go duration, maximum 30s.
OIDC_CHECK_TIMEOUT=5s

# -- Database ----------------------------------------------------------
# infrastructure/postgres/auth/setup.ps1 generates these for isolated local
# development. Never use the owner connection as DATABASE_URL. Remote databases
# require sslmode=verify-full.
DATABASE_URL=
# Independent, stable base64-encoded 32-byte secrets. Back up outside Git.
PROFILE_DATA_KEY=
NIC_INDEX_KEY=

# -- Registration ------------------------------------------------------
# Opt-in. Generate the stable keys with .\scripts\new-registration-env.ps1, then
# complete the client settings with dev-auth configure.
# See docs/GA-48-registration-runtime.md.
REGISTRATION_ENABLED=false
REGISTRATION_KEYCLOAK_URL=
REGISTRATION_REALM=GovAI
REGISTRATION_CLIENT_ID=
REGISTRATION_CLIENT_SECRET=
REGISTRATION_GROUP_PATH=/ga48-registration
REGISTRATION_VERIFICATION_CLIENT_ID=
REGISTRATION_VERIFICATION_REDIRECT=
# Optional additional trusted CA bundle for the HTTPS Keycloak server.
REGISTRATION_CA_FILE=
# Independent, stable base64-encoded 32-byte secrets.
REGISTRATION_FINGERPRINT_KEY=
REGISTRATION_RATE_KEY=

# -- Login (mobile) ----------------------------------------------------
# Native mobile/Postman access-token login. Local setup:
# go run ./tools/dev-auth configure-login. See docs/GA-48-login.md.
# Keep the login client separate from the registration admin client.
LOGIN_ENABLED=false
LOGIN_ISSUER_URL=
LOGIN_CLIENT_ID=
LOGIN_CLIENT_SECRET=
LOGIN_AUDIENCE=govai-api
LOGIN_CA_FILE=
LOGIN_RATE_KEY=
# Opt-in native token issuance and /api/v1/auth/refresh + /revoke.
# Requires a reviewed refresh-enabled Keycloak client; see GA-50 documentation.
LOGIN_REFRESH_ENABLED=false

# -- API authorization -------------------------------------------------
# Shared JWT/RBAC protected endpoints. Local setup:
# go run ./tools/dev-auth configure-authorization
API_AUTH_ENABLED=false
API_AUTH_ISSUER=
API_AUTH_AUDIENCE=
API_AUTH_CLIENT_IDS=
API_AUTH_CA_FILE=

# -- Web session (browser) ---------------------------------------------
# Opt-in encrypted browser sessions. Separate web client and independent keys
# are required; see docs/GA-50-token-management.md. Migration is explicit.
# WEB_ORIGIN is the exact web app origin, e.g. https://localhost:5173.
WEB_SESSION_ENABLED=false
WEB_ORIGIN=
WEB_ISSUER_URL=
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
WEB_AUDIENCE=
WEB_CA_FILE=
WEB_SESSION_DATA_KEY=
WEB_RATE_KEY=
WEB_SESSION_LIFETIME=30m

# -- Web chat ----------------------------------------------------------
# Optional browser-session chat gateway. Configure only after core startup is verified.
# Requires WEB_SESSION_ENABLED=true: with web sessions off, true stops startup
# (chat_gateway_unavailable).
WEB_CHAT_ENABLED=false
WEB_CHAT_CORE_URL=https://localhost:5002/api/chat/message
WEB_CHAT_CA_FILE=../../../infrastructure/keycloak/tls/ca.pem
# 1s-30s; keep it above core-service CHAT_REQUEST_TIMEOUT.
WEB_CHAT_TIMEOUT=30s

# -- Password recovery (GA-91) -----------------------------------------
# Disabled by default. Requires existing registration + web settings, explicit
# migrations 004/005/006, and guarded web sessions on ALL API instances.
# Existing cookies need re-login.
RECOVERY_ENABLED=false
RECOVERY_RESET_URL=
RECOVERY_BINDING_KEY=
RECOVERY_FENCE_KEY=
RECOVERY_RATE_KEY=
RECOVERY_LIFETIME=15m
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=
RECOVERY_SMTP_FROM=
RECOVERY_SMTP_USERNAME=
RECOVERY_SMTP_PASSWORD=
# Only literal loopback SMTP with no auth; never enable for remote SMTP.
RECOVERY_SMTP_DEV_PLAINTEXT=false
