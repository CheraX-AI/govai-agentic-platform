# Dedicated sandbox settings. Do not commit the populated .env.smtp-sandbox file.

EMAIL_ENABLED=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=replace_with_sandbox_username
SMTP_PASSWORD=replace_with_sandbox_password
SMTP_FROM=noreply@govai.test
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s
NOTIFICATION_ENV=development
