# HTTP here exposes only local foundation health; citizen APIs are not mounted.

NOTIFICATION_ENV=development
NOTIFICATION_LISTEN_ADDRESS=127.0.0.1:5003
NOTIFICATION_SECURITY_PREFETCH=10
NOTIFICATION_NORMAL_PREFETCH=2

# Copy the consumer credentials from infrastructure/rabbitmq/.env locally.

RABBITMQ_SCHEME=amqp
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_VHOST=govai
RABBITMQ_CONSUMER_USER=govai_notifications
RABBITMQ_CONSUMER_PASSWORD=replace_with_local_consumer_password
RABBITMQ_CA_FILE=

# Future delivery-worker settings; email remains disabled in this foundation.

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=10s

# Future database integration; GA-208 owns provisioning and migrations.

NOTIFICATION_DATABASE_ENABLED=false
NOTIFICATION_DB_HOST=127.0.0.1
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_NAME=govai_notifications
NOTIFICATION_DB_USER=replace_with_notification_service_user
NOTIFICATION_DB_PASSWORD=replace_with_notification_service_password
NOTIFICATION_DB_SSLMODE=verify-full
NOTIFICATION_DB_CA_FILE=
NOTIFICATION_DB_MAX_CONNECTIONS=8
NOTIFICATION_DB_TIMEOUT=5s
