# Run from backend/services/core-service. Secrets/private TLS material stay ignored.
CORE_PORT=5002
CORE_TLS_CERT_FILE=
CORE_TLS_KEY_FILE=
CHAT_ISSUER_URL=https://localhost:8443/realms/GovAI
CHAT_AUDIENCE=govai-api
CHAT_ALLOWED_CLIENTS=govai-login-mobile-dev,govai-login-web-dev,govai-postman-dev
CHAT_CA_FILE=../../dev/keycloak/tls/ca.pem
# Exact HTTPS origins, comma separated; blank supports Postman/native/server calls.
CHAT_ALLOWED_ORIGINS=
# GA-66 will add the agreed Knowledge Agent transport. Until then valid chat
# requests return 503; only tests inject a synthetic agent with explicit fixtures.