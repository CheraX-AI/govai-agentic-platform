# Run from backend/services/core-service. Secrets/private TLS material stay ignored.
CORE_PORT=5002
CORE_TLS_CERT_FILE=
CORE_TLS_KEY_FILE=
CHAT_ISSUER_URL=https://localhost:8443/realms/GovAI
CHAT_AUDIENCE=govai-api
CHAT_ALLOWED_CLIENTS=govai-login-mobile-dev,govai-login-web-dev,govai-postman-dev
CHAT_CA_FILE=../../../infrastructure/keycloak/tls/ca.pem
# Exact HTTPS origins, comma separated; blank supports Postman/native/server calls.
CHAT_ALLOWED_ORIGINS=

# Disabled until the Python owner confirms the exact contract and service auth.
CHAT_REQUEST_TIMEOUT=30s
KNOWLEDGE_AGENT_ENABLED=false
KNOWLEDGE_AGENT_URL=
KNOWLEDGE_AGENT_AUTH_MODE=
KNOWLEDGE_AGENT_BEARER_TOKEN=
KNOWLEDGE_AGENT_TIMEOUT=20s
KNOWLEDGE_AGENT_CA_FILE=
KNOWLEDGE_AGENT_ALLOW_LOOPBACK_HTTP=false