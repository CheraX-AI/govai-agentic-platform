# Keep secrets, local environments, and caches out of the image

# Secrets: settings come from the compose env_file at runtime
.env
.env.*

# Local virtual environments
.venv/
venv/

# Tests run outside the image
tests/
pytest.ini
.pytest_cache/

# Python cache
__pycache__/
*.py[cod]

# Editor, Git, and Docker files
.git/
.gitignore
.vscode/
.idea/
Dockerfile
.dockerignore
