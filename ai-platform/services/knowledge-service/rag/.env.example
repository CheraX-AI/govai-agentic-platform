# NVIDIA embedding settings for the knowledge-service RAG pipeline.
# Copy this file to .env and fill in NVIDIA_API_KEY. Never commit .env.
# Every value below is required; the code has no defaults.

# Secret: API key from build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=

# Embedding model. Changing it requires re-embedding all documents.
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b

# Chunks per API request (1-50)
EMBEDDING_BATCH_SIZE=50

# Retries for rate limits (429) and server errors (5xx), 0-5
EMBEDDING_MAX_RETRIES=2

# Wait before the first retry; doubles on each further retry
EMBEDDING_RETRY_DELAY_SECONDS=1.0

# What to do with a chunk longer than the model accepts:
# NONE fails the chunk (recommended, no text is lost), START or END cuts text
EMBEDDING_TRUNCATE=NONE
