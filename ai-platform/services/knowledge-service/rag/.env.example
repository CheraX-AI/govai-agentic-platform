# NVIDIA embedding settings for the knowledge-service RAG pipeline.
# Copy this file to .env and fill in NVIDIA_API_KEY. Never commit .env.
# Every value below is required; the code has no defaults.

# Secret: API key from build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=

# Embedding model. Changing it requires re-embedding all documents.
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# Chunks per API request (1-50)
EMBEDDING_BATCH_SIZE=50

# Retries for rate limits (429) and server errors (5xx), 0-5
EMBEDDING_MAX_RETRIES=2

# Wait before the first retry; doubles on each further retry
EMBEDDING_RETRY_DELAY_SECONDS=1.0

# What to do with a chunk longer than the model accepts:
# NONE fails the chunk (recommended, no text is lost), START or END cuts text
EMBEDDING_TRUNCATE=NONE

# SeaweedFS object storage for the original PDFs (S3 API).
# Use the same OBJECT_STORAGE_* values as the repository root .env,
# which docker-compose uses to create the SeaweedFS user.

# S3 API address; inside Docker use http://seaweedfs:8333
OBJECT_STORAGE_ENDPOINT=http://localhost:8333

# Bucket for verified government documents (create it once, see infrastructure/object-storage/README.md)
OBJECT_STORAGE_BUCKET=govai-knowledge

# Any region name; SeaweedFS only needs it for request signing
OBJECT_STORAGE_REGION=ap-south-1

# Secret: must match the root .env
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ChromaDB vector database (start it with: docker compose up -d chromadb)

# Host and port of the ChromaDB API; the port is CHROMA_PORT from the root .env.
# Inside Docker use CHROMA_HOST=chromadb and CHROMA_PORT=8000
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Collection for all government document chunks (created automatically)
CHROMA_COLLECTION=govai_knowledge
