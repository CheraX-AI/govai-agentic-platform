# Keep secrets, local environments, and caches out of the image

# Secrets: settings come from the compose env_file at runtime
.env
.env.*

# Local virtual environments
.venv/
venv/

# Local tool state (Chainlit and LangGraph recreate these in the container)
.chainlit/
.files/
chainlit.md
.langgraph_api/

# Local test scripts that are not part of the service
scripts/test_langsmith.py
scripts/test_llm_trace.py

# Tests run outside the image
tests/
pytest.ini
.pytest_cache/

# Python cache
__pycache__/
*.py[cod]

# Editor, Git, and Docker files
.git/
.gitignore
.vscode/
.idea/
Dockerfile
.dockerignore
