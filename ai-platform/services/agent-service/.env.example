# Copy this file to .env and fill in local values. Never commit .env.

# NVIDIA chat model for the GovAI agents.
# Every LLM value below is required; the code has no defaults.

# Secret: API key from build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=

# NVIDIA chat model ID, e.g. from build.nvidia.com (set it yourself)
LLM_MODEL=

# Sampling temperature, 0-1. Keep it low so answers stay close to the documents
LLM_TEMPERATURE=0.1

# Maximum tokens in one answer, 1-4096
LLM_MAX_TOKENS=1024

# Seconds to wait for NVIDIA before giving up, up to 120
LLM_TIMEOUT_SECONDS=30

# Knowledge service (RAG) internal retrieval API. Every value is required.
# Start it first: see knowledge-service/rag/README.md, "Retrieval API (internal)".

# Address of the knowledge service; it listens on 127.0.0.1 only
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8020

# Document chunks retrieved for each question, 1-50
KNOWLEDGE_TOP_K=5

# Seconds to wait for the knowledge service (it embeds the question with NVIDIA), up to 120
KNOWLEDGE_TIMEOUT_SECONDS=30

# Agent API (app/api) that core-service calls. Both values are read only by the API.

# bearer: every chat request needs the token below (use it everywhere except a
# quick local test). none: no token, only with the API bound to 127.0.0.1.
AGENT_API_AUTH_MODE=bearer

# Secret: a random service token of 32+ printable characters, e.g. from
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Put the same value in core-service's KNOWLEDGE_AGENT_BEARER_TOKEN. core-service also sends
# the citizen it verified in X-GovAI-Citizen; the agent trusts it only with this token.
AGENT_API_TOKEN=

# Conversations and memory (read only by the agent API). agent-service creates
# conversation IDs, checks their owner, and keeps every turn. Leave the database URL
# blank to answer every question without conversations. One-time setup: README,
# "Conversations and memory".

# Runtime login for the govai_agent database: every turn (long-term memory) and the
# LangGraph checkpoints (short-term memory). Use host postgres when agent-api runs in
# Docker, 127.0.0.1 when it runs on this machine.
AGENT_MEMORY_DATABASE_URL=

# Secret: encrypts questions, answers and checkpoints (AES-256). Base64 of 32 random
# bytes. Keep it and back it up apart from the database: losing it loses every
# conversation. Generate:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
AGENT_MEMORY_DATA_KEY=

# ID of the key above, 1-255. To rotate: give a new key a new ID, move the old one to
# AGENT_MEMORY_OLD_DATA_KEYS, run scripts/reencrypt_memory.py, then remove the old key.
AGENT_MEMORY_DATA_KEY_ID=1

# Secret: older keys that can still decrypt, as id:base64 entries separated by commas
AGENT_MEMORY_OLD_DATA_KEYS=

# Short-term memory: answered turns kept in each conversation's checkpoint, 1-20
AGENT_MEMORY_MAX_TURNS=6

# A pending question older than this many seconds was abandoned, 30-600
AGENT_MEMORY_IN_FLIGHT_SECONDS=90

# A repeated question this many seconds after its answer gets the stored answer, 0-3600
AGENT_MEMORY_REPLAY_SECONDS=600

# Optional: send traces to LangSmith. Leave tracing off for real government data
# unless sending it to LangSmith has been approved.
LANGSMITH_TRACING=false

# Secret: API key from smith.langchain.com (Settings > API Keys)
LANGSMITH_API_KEY=

# LangSmith project the traces are grouped under
LANGSMITH_PROJECT=govai-agent-dev

# Only for a LangSmith account in the EU region
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Hide the question, document, and answer text in traces (timing, model, token
# counts, tags, and metadata are still sent). Set both to false only when testing
# with synthetic questions.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
