# Copy this file to .env and fill in local values. Never commit .env.

# NVIDIA chat model for the GovAI agents.
# Every LLM value below is required; the code has no defaults.

# Secret: API key from build.nvidia.com (starts with nvapi-)
NVIDIA_API_KEY=

# NVIDIA chat model ID, e.g. from build.nvidia.com (set it yourself)
LLM_MODEL=

# Sampling temperature, 0-1. Keep it low so answers stay close to the documents
LLM_TEMPERATURE=0.1

# Maximum tokens in one answer, 1-4096
LLM_MAX_TOKENS=1024

# Seconds to wait for NVIDIA before giving up, up to 120
LLM_TIMEOUT_SECONDS=30

# Knowledge service (RAG) internal retrieval API. Every value is required.
# Start it first: see knowledge-service/rag/README.md, "Retrieval API (internal)".

# Address of the knowledge service; it listens on 127.0.0.1 only
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8020

# Document chunks retrieved for each question, 1-50
KNOWLEDGE_TOP_K=5

# Seconds to wait for the knowledge service (it embeds the question with NVIDIA), up to 120
KNOWLEDGE_TIMEOUT_SECONDS=30

# Optional: send traces to LangSmith. Leave tracing off for real government data
# unless sending it to LangSmith has been approved.
LANGSMITH_TRACING=false

# Secret: API key from smith.langchain.com (Settings > API Keys)
LANGSMITH_API_KEY=

# LangSmith project the traces are grouped under
LANGSMITH_PROJECT=govai-agent-dev

# Only for a LangSmith account in the EU region
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# Hide the question, document, and answer text in traces (timing, model, token
# counts, tags, and metadata are still sent). Set both to false only when testing
# with synthetic questions.
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
