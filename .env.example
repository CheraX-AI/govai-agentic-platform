# PostgreSQL
POSTGRES_USER=govai_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=govai_db
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Object Storage (SeaweedFS S3 API)
SEAWEEDFS_S3_PORT=8333
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_BUCKET=govai-documents
OBJECT_STORAGE_REGION=ap-south-1
OBJECT_STORAGE_ACCESS_KEY=govai_access_key
OBJECT_STORAGE_SECRET_KEY=change_this_object_storage_secret

# ChromaDB
CHROMA_PORT=8001

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@govai.local
PGADMIN_DEFAULT_PASSWORD=change_this_pgadmin_password
PGADMIN_PORT=5050

# RedisInsight
REDIS_INSIGHT_PORT=5540